# ==========================================
# CASHHUB - Git Ignore
# ==========================================

# ---------- Java / Maven ----------
**/target/
*.class
*.log

# ---------- Node.js ----------
**/node_modules/

# Arquivos compilados do TypeScript
/frontend/dist/

# ---------- Credenciais e variáveis de ambiente ----------
.env
.env.*
!.env.example

# Configurações locais que podem conter senhas
**/application-local.properties
**/application-*.local.properties

# ---------- IDEs e editores ----------
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/

# ---------- Sistema operacional ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs ----------
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*